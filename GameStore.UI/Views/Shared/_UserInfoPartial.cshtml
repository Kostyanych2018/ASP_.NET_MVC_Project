@using GameStore.Application.Common.Constants
@using GameStore.UI.Extensions
@{
    var username = User.Claims.FirstOrDefault(c => c.Type.Equals("preferred_username", StringComparison.OrdinalIgnoreCase))?.Value;
                   

    var avatarClaim = User.Claims.FirstOrDefault(c => c.Type.Equals("avatar", StringComparison.OrdinalIgnoreCase))?.Value;
    var avatarUrl = Url.ApiAvatar(avatarClaim);
}

<div class="d-flex align-items-center">
    @if (User.Identity?.IsAuthenticated == true)
    {
        @if(User.IsInRole(AuthConstants.UserRole) && !User.IsInRole(AuthConstants.AdminRole))
        {
            @await Component.InvokeAsync("Cart")
        }
        <div class="dropdown ms-3">
            <button class="btn btn-dark dropdown-toggle d-flex align-items-center border-secondary"
                    type="button"
                    id="userDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                <img src="@avatarUrl"
                     width="28"
                     height="28"
                     alt="Avatar"
                     class="rounded-circle me-2 border border-light"
                     style="object-fit: cover;"/>
                <span>@username</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                <li>
                    <div class="dropdown-item-text d-flex align-items-center">
                        <img src="@avatarUrl"
                             width="40"
                             height="40"
                             alt="Avatar"
                             class="rounded-circle me-2 border"
                             style="object-fit: cover;"/>
                        <div>
                            <div class="fw-bold">@username</div>
                            <small class="text-muted">Signed in</small>
                        </div>
                    </div>
                </li>
                @if (User.IsInRole(AuthConstants.AdminRole))
                {
                    <li><hr class="dropdown-divider"/></li>
                    <li>
                        <a class="dropdown-item text-primary" asp-area="Admin" asp-page="/Games/Index">
                            <i class="bi bi-gear-fill me-2"></i>Admin Panel
                        </a>
                    </li>
                }
                <li><hr class="dropdown-divider"/></li>
                <li>
                    <form method="post" asp-controller="Account" asp-action="Logout" class="px-2">
                        <button type="submit" class="dropdown-item text-danger rounded">
                            <i class="bi bi-box-arrow-right me-2"></i>Sign out
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    }
    else
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>Sign in
            </a>
            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">
                <i class="bi bi-person-plus me-1"></i>Register
            </a>
        </div>
    }
</div>
