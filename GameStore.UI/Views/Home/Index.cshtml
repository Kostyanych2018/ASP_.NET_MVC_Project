@{
    ViewData["Title"] = "Home - GameStore";
}

<div class="p-5 mb-4 bg-body-tertiary rounded-3 mt-4 border shadow-sm">
    <div class="container-fluid py-4 text-center">
        <h1 class="display-4 fw-bold text-primary mb-3">
            <i class="bi bi-controller me-2"></i>GameStore
        </h1>
        <p class="col-md-8 fs-5 text-muted mx-auto mb-4">
            Welcome to the digital game store. Top hits, new releases,
            and instant access to your game library.
        </p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a asp-controller="Game" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3 shadow">
                <i class="bi bi-grid-fill me-2"></i>Browse catalog
            </a>
        </div>
    </div>
</div>

<div class="row g-4 py-3 row-cols-1 row-cols-lg-3 text-center">
    <div class="col">
        <div class="card h-100 p-4 shadow-sm border-0 bg-light">
            <div class="feature-icon d-inline-flex align-items-center justify-content-center text-primary fs-1 mb-3">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <h4 class="fw-semibold mb-2">Instant Access</h4>
            <p class="text-muted">
                Add games to your cart in just a few clicks.
            </p>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 p-4 shadow-sm border-0 bg-light">
            <div class="feature-icon d-inline-flex align-items-center justify-content-center text-success fs-1 mb-3">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h4 class="fw-semibold mb-2">Keycloak Security</h4>
            <p class="text-muted">
                Reliable OpenID Connect authentication and personal data protection.
            </p>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 p-4 shadow-sm border-0 bg-light">
            <div class="feature-icon d-inline-flex align-items-center justify-content-center text-danger fs-1 mb-3">
                <i class="bi bi-tags-fill"></i>
            </div>
            <h4 class="fw-semibold mb-2">Wide Genre Selection</h4>
            <p class="text-muted">
                Filter by category: action, RPG, strategy, indie, and simulators.
            </p>
        </div>
    </div>
</div>
