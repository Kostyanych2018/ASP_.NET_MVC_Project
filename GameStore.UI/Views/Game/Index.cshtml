@using GameStore.Application.Genres.DTOs

@{
    var genres = ViewData["Genres"] as List<GenreDto>;
    var currentGenreName = ViewData["CurrentGenreName"] as string;
}
<h1>@ViewData["Title"]</h1>

<div class="dropdown mb-4">
    <button class="btn btn-secondary dropdown-toggle"
            aria-expanded="False"
            id="genreDropdown"
            data-bs-toggle="dropdown"
            type="button">
        @currentGenreName
    </button>
    <ul class="dropdown-menu">
        <li>
            <a class="dropdown-item"
               asp-controller="Game"
               asp-action="Index"
               asp-route-genre="@null">
                All categories</a>
        </li>
        @if (genres != null && genres.Count > 0)
        {
            @foreach (var genre in genres)
            {
                <li>
                    <a class="dropdown-item"
                       asp-controller="Game"
                       asp-action="Index"
                       asp-route-genre="@genre.NormalizedName">
                        @genre.Name
                    </a>
                </li>
            }
        }
    </ul>
</div>

<div class="ajax-pagination-container">
    <partial name="_GameListPartial" model="Model"/>
</div>
